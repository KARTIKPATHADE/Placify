# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL Database URL
NEXT_PUBLIC_DRIZZLE_DB_URL=your_neon_postgresql_connection_string

# Google Gemini API Key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Interview Configurations
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_INFORMATION=Review each question carefully and answer as you would in a real interview. Speak clearly so the AI evaluator can accurately understand and rate your responses.
NEXT_PUBLIC_QUESTION_NOTE=Click on Record Answer when you are ready. Structure your thoughts clearly with specific examples.
